# Copy to config/.env (gitignored). No site credentials ever go here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signs the session cookies. No default and no fallback: the auth service
# refuses to start without it, and every session it ever issued dies when it
# changes. At least 32 characters of actual randomness --
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# How a one-time code reaches the person: `log` writes it to the container log
# (development only — anyone who can read the log can sign in), `telegram` needs
# the two variables above to be set.
AUTH_SENDER=log
