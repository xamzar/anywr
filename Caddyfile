# TLS is automatic (Let's Encrypt) once anywr.me points at this VM.
www.anywr.me {
	redir https://anywr.me{uri} permanent
}

anywr.me {
	# The live viewer. forward_auth asks the api whose browser this cookie
	# belongs to (starting it if asleep) and proxies to that container's noVNC,
	# which is reachable only because Caddy is on that user's network.
	handle_path /view/* {
		forward_auth anywr-api:8000 {
			uri /auth/view
			copy_headers X-Upstream
		}
		reverse_proxy {header.X-Upstream}
	}
	reverse_proxy anywr-api:8000
}
